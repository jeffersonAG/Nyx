# Plantilla de EJEMPLO para .env.security (privado, excluido de Git).
# Escoge 'emailjs' o 'smtp'; por defecto NYX usa SMTP, si se ha configurado.
NYX_MAIL_PROVIDER=smtp

# EmailJS (recomendado si ya tienes Gmail conectado al servicio).
# Encontrar Service ID en EmailJS > Email Services.
# Encontrar Template ID en EmailJS > Email Templates.
# Habilitar uso desde servidor en EmailJS > Account > Security.
# Nunca publicar claves reales.
NYX_EMAILJS_SERVICE_ID=
NYX_EMAILJS_TEMPLATE_ID=
NYX_EMAILJS_PUBLIC_KEY=
NYX_EMAILJS_PRIVATE_KEY=

# Alternativa SMTP clásica
NYX_SMTP_HOST=
NYX_SMTP_PORT=587
NYX_SMTP_SECURITY=starttls
NYX_SMTP_USER=
NYX_SMTP_PASSWORD=
NYX_SMTP_FROM=

# Cuenta de destino para mostrar estado enmascarado.
# En EmailJS el destinatario real se fija en la plantilla, no aquí.
NYX_ALERT_EMAIL_TO=
